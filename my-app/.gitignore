# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*

# next.js build output
/.next/
/out/
/build

# testing
/coverage

# env files — never commit; see README for the required keys
.env*
# ...except the template, which holds only blanks and is meant to be shared.
# This line must come AFTER the pattern above: git takes the LAST match.
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AI-assistant config (local only)
.claude/
CLAUDE.md
AGENTS.md

# editors / IDEs
.vscode/
.idea/
*.swp
*.swo

# OS cruft
.DS_Store
Thumbs.db
*.pem

# logs
*.log
npm-debug.log*
yarn-debug.log*
.pnpm-debug.log*

# internal reports & working notes (README.md is the only tracked document)
/docs/

# local scratch: demo SQL, browser-automation output, diagrams, screenshots
/demo/
/scripts/demo/
.playwright-mcp/
*.drawio
/*.png
