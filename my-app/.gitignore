# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AI-assistant config + internal docs (whole dir kept local only — never commit)
.claude/
CLAUDE.md
AGENTS.md

# editors / IDEs
.vscode/
.idea/
*.swp
*.swo

# OS cruft
Thumbs.db

# Playwright MCP scratch (test-run artifacts, not part of the app)
.playwright-mcp/

# logs (any stray run logs)
*.log

# local-only docs & scratch — internal notes, not needed to build or deploy
/ARCHITECTURE.md
/MIGRATION-PLAN.md
/WIREFLOW.md
/PLAN-*.md
*-PLAN.md
*.drawio
SCHEMA_COMPARISON_FLOWCHART*.md

# local demo / scratch SQL (seed + test data, not part of the app)
/demo/
/scripts/demo/
/seed-demo.cjs

# local presentation artifact (code walkthrough for the FYP demo, not part of the app)
/CODEBASE-WALKTHROUGH.html

# impeccable design-context files (local design system docs, generated by /impeccable)
/DESIGN.md
/PRODUCT.md
/.impeccable/

# Local test-data seeder (no secrets, but not part of the app)
/seed-test-schemas.cjs
