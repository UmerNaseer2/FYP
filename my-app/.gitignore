# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local assistant/editor settings
.claude/settings.local.json

# editors / IDEs
.vscode/
.idea/
*.swp
*.swo

# OS cruft
Thumbs.db

# Playwright MCP scratch (test-run artifacts, not part of the app)
.playwright-mcp/

# logs (any stray run logs)
*.log

# local-only docs & scratch — internal notes, not needed to build or deploy
/ARCHITECTURE.md
/MIGRATION-PLAN.md
/WIREFLOW.md
/PLAN-*.md

# local demo / scratch SQL (seed + test data, not part of the app)
/demo/

# impeccable design-context files (local design system docs, generated by /impeccable)
/DESIGN.md
/PRODUCT.md
/.impeccable/
