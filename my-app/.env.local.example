# ---------------------------------------------------------------------------
# Schema Studio — local environment template
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` (same folder) and fill in the blanks.
# `.env.local` is git-ignored and must NEVER be committed — it holds secrets.
# Do NOT paste real secret values into this .example file.
#
#   cp .env.local.example .env.local
#
# Only DATABASE_URL_A is required. Everything below it is optional, and each
# section says what stops working if you leave it blank.
# ---------------------------------------------------------------------------

# --- Database (local Docker) ------------------------------------------------
# Points at the Postgres 17 container from the repo-root docker-compose.yml.
# Start it first, from the REPO ROOT:  docker compose up -d db
# This default works out of the box — no editing needed for local testing.
#
# This is the app's OWN metadata database (connections, versions, approvals,
# lineage). The databases you compare are added on the Connections screen, not
# here.
DATABASE_URL_A=postgres://studio:studio@localhost:5433/studio

# --- Auth -------------------------------------------------------------------
# Keep this line while you are testing: it skips login and signs you in as
# admin. The Entra keys below are not configured yet, so without it there is no
# way into the app at all.
#
# `true`, `1`, `yes` or `on` — any case, surrounding spaces ignored — turn the
# bypass on. ANYTHING ELSE, including a typo and including leaving the line out
# altogether, means real sign-in. That way round on purpose: a checkout that
# comes up locked tells you so on the first click, while one that comes up open
# looks exactly like one that is properly signed in.
#
# READ AT BUILD TIME, NOT RUN TIME. Next substitutes every NEXT_PUBLIC_ variable
# for its value while compiling. `npm run dev` recompiles and picks up an edit
# on the next request, but a built app does not: rebuild it, or for Docker pass
# `--build-arg NEXT_PUBLIC_AUTH_BYPASS=true`. There is no sign-in screen either
# way, so nothing on screen tells you which one you got.
NEXT_PUBLIC_AUTH_BYPASS=true

# --- Microsoft Entra sign-in (only needed when the bypass is OFF) -----------
# Register an app in Entra ID and paste its details here. With the bypass on
# sign-in is never reached, so the three AZURE_AD_ values are unused — but
# NEXTAUTH_SECRET is still read, as a fallback encryption key. See below.
NEXTAUTH_SECRET=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# NEXTAUTH_SECRET signs the session cookie. Generate your own:
#   openssl rand -base64 32
# It must be the same across every instance of the app, or sessions issued by
# one are rejected by the next.

# --- Connection-password encryption ----------------------------------------
# Encrypts the DB passwords you save on the Connections screen (32 bytes).
# Generate your OWN key for local testing (you'll save your own connections):
#   openssl rand -hex 32
# Paste the output after the = sign. Base64 is accepted too.
#
# If this is blank the app derives a key from NEXTAUTH_SECRET instead. If BOTH
# are blank it still runs, but it logs a warning and saves those passwords in
# PLAIN TEXT. Existing rows re-encrypt themselves the next time they are saved,
# so setting this later is safe — but changing it after the fact makes rows
# written under the old key unreadable.
APP_ENCRYPTION_KEY=

# --- GitHub script registry (only needed for push/pull deploy tests) --------
# A Personal Access Token with repo access to the script-registry repo.
# Ask Umer for the token + which repo to use, OR use your own test repo.
# Leave blank if you're not testing the registry push/pull features.
GITHUB_PAT=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# --- Optional switches ------------------------------------------------------
# Both of these are off/unset for normal local work. Listed so they are findable
# rather than because you need them.

# Allow target databases on loopback, unix sockets and the private ranges when
# NODE_ENV=production. Blocked by default there, because those addresses reach
# the app server's own machine — set this to `true` only on a trusted or VPC
# deployment. Development is unaffected either way, which is why a localhost
# target works locally and then fails once deployed.
ALLOW_PRIVATE_DB_HOSTS=

# `off`, `false` or `0` stop the background drift checker from running at all —
# for a demo where nobody wants a scheduled job touching a database
# mid-presentation. Anything else, including blank, leaves it on.
DRIFT_SCHEDULER=
