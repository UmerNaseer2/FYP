# Copy this file to .env.desktop (which git ignores) and fill in the two IDs
# from the Schema Studio app registration in Microsoft Entra:
#   portal.azure.com > Microsoft Entra ID > App registrations > Schema Studio
#   > Overview, where both are listed.
#
# Neither is a secret, and the app needs no client secret at all: it signs in
# the way a desktop app should, in the system browser, with PKCE. The app
# registration needs one extra redirect URI for this, under Authentication >
# Add a platform > Mobile and desktop applications > Custom: http://localhost
#
# A build made without these still installs and runs, but the sign-in screen
# says sign-in is not set up.
AZURE_AD_CLIENT_ID=
AZURE_AD_TENANT_ID=
