# Runs deploy/backup.sh once, as the schemastudio account, to save a copy of
# the app's database in /srv/schema-studio/backups.
# schema-studio-backup.timer starts it every night at 02:30.
# deploy/HARDENING.md (step 4) copies both files to /etc/systemd/system/.
#
# Its output goes to the system journal. To read it:
#   sudo journalctl -t schema-studio-backup

[Unit]
Description=Schema Studio: save a copy of its database
After=docker.service

[Service]
Type=oneshot
User=schemastudio
Group=schemastudio
ExecStart=/srv/schema-studio/deploy/backup.sh
SyslogIdentifier=schema-studio-backup
# /snap/bin in case Docker came as a snap.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin
# A copy takes seconds, or up to half an hour when it waits for a deploy to
# finish first. Stop a run that hangs.
TimeoutStartSec=1h
