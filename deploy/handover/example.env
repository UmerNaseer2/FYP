# Schema Studio settings.
#
# Copy this file to .env in the same folder as docker-compose.yml, fill it in,
# then make it readable by its owner only:
#
#   cp example.env .env
#   chmod 600 .env
#
# SETUP-GUIDE.md, step 5, fills in the generated values with exact commands.
# Or let setup.sh make and fill in .env for you (SETUP-GUIDE.md, "The quick
# way: one command").
# .env holds secrets: never commit it, never paste it into a chat or a ticket.
# A value with a $ in it goes inside single quotes, for example 'a$b'.

# ---------------------------------------------------------------------------
# The image and where the app listens
# ---------------------------------------------------------------------------

# The image you loaded with docker load (SETUP-GUIDE.md, step 2).
APP_IMAGE=schema-studio-app:handover

# 127.0.0.1 keeps the app to this machine. 0.0.0.0 also lets other computers
# reach it (SETUP-GUIDE.md, "Common problems"). Nothing else works here.
APP_BIND=127.0.0.1
APP_PORT=3000

# The address people type into the browser, with no path and no slash at the
# end. It must match the redirect address on the Microsoft app registration.
AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# The app's own database (SETUP-GUIDE.md, steps 3 to 5).
#   PostgreSQL on this machine:
#     postgres://schema_studio:THE_PASSWORD@127.0.0.1:5432/schema_studio
#   Your own Supabase project: the Transaction pooler string from Connect,
#   with your database password in it (port 6543).
DATABASE_URL_A=

# Two separate random values: openssl rand -hex 32
# NEXTAUTH_SECRET signs the sign-in cookie. Changing it signs everyone out.
NEXTAUTH_SECRET=
# APP_ENCRYPTION_KEY encrypts the saved database passwords and GitHub tokens.
# Keep a copy somewhere safe: if it is lost or changed, the saved passwords
# cannot be read and have to be typed in again.
APP_ENCRYPTION_KEY=

# Microsoft Entra ID sign-in, from your own app registration
# (SETUP-GUIDE.md, step 6).
#   Application (client) ID and Directory (tenant) ID: the registration's
#   Overview page. The secret: Certificates & secrets, the Value column (not
#   the Secret ID).
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
# true only if the registration takes accounts in any organizational
# directory (multitenant). Leave empty for your own directory only.
AZURE_AD_ANY_ACCOUNT=

# ---------------------------------------------------------------------------
# Databases at private addresses
# ---------------------------------------------------------------------------

# The app refuses to connect to localhost, 10.x, 172.16-31.x and 192.168.x
# unless this is true. On your own machine and network it should be.
ALLOW_PRIVATE_DB_HOSTS=true

# ---------------------------------------------------------------------------
# Optional: GitHub, where the app keeps every deployed script
# ---------------------------------------------------------------------------

# Leave these empty and set the repository on the Admin screen, under GitHub,
# instead (SETUP-GUIDE.md, step 9). Values here are only the default
# organization's fallback until an Admin saves one there.
GITHUB_PAT=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# ---------------------------------------------------------------------------
# Optional: drift checks
# ---------------------------------------------------------------------------

# The app checks tracked schemas for drift on its own timer. off stops it.
DRIFT_SCHEDULER=

# ---------------------------------------------------------------------------
# Optional: AI help (SETUP-GUIDE.md, "Settings reference")
# ---------------------------------------------------------------------------

# Off unless AI_BASE_URL, AI_API_KEY and a model are all set, and then still
# off for an organization until its Admin turns it on in Admin, AI. An Admin
# can also save the organization's own key there instead of setting these.
# Any service with an OpenAI-style API works (Gemini, Groq, OpenRouter,
# Ollama). AI_BASE_URL ends in a slash, for example
# https://generativelanguage.googleapis.com/v1beta/openai/
AI_PROVIDER=openai-compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL_FAST=
AI_MODEL_SMART=
AI_REASONING_EFFORT=
AI_TIMEOUT_MS=
AI_DAILY_LIMIT=
AI_PER_MINUTE=

# ---------------------------------------------------------------------------
# Docker Desktop only (Mac, Windows), not Docker Engine on Ubuntu
# ---------------------------------------------------------------------------

# Docker Desktop does not share the computer's network with containers by
# default. Uncomment this line to add the second file, which publishes the
# port instead. The database host in DATABASE_URL_A is then
# host.docker.internal, with ?sslmode=disable on the end
# (SETUP-GUIDE.md, "Common problems").
# COMPOSE_FILE=docker-compose.yml:docker-compose.docker-desktop.yml
