.DS_Store
node_modules

# AI-assistant config (local only)
.claude/

# The signed Student Project Agreement must never reach this public repo: it is a
# legal form carrying signatures and personal details.
docs/**/*Agreement*.pdf

# Local scratch that lives beside the project but is not part of it. The same
# two lines exist in my-app/.gitignore; these cover the repo root, because a
# pattern in a subdirectory's file only ever matches inside that subdirectory.
#
# /demo/   the bookshop fixture and its runbook — seed data for a walkthrough,
#          rebuilt from scratch whenever it is needed, so it is not source.
# /*.pdf   generated handouts at the root, e.g. Schema-Studio-Field-Guide.pdf.
#          Documents that are meant to be kept go in docs/ and are tracked.
/demo/
/*.pdf

# Settings for `docker compose`, which reads a file named .env beside
# docker-compose.yml. It holds real keys (APP_ENCRYPTION_KEY and friends), and
# this repo is public, so it must never be committed. my-app/.gitignore already
# covers my-app/.env*, but not this folder.
.env

# An image saved with `docker save` to try the handover kit locally (the
# kit's guide makes one). It is a build output, hundreds of megabytes.
/schema-studio-app-*.tar.gz
/schema-studio-app-*.tar.gz.sha256

# Private notes from client and supervisor meetings, with their transcripts.
# They name real people and this repo is public, so they stay local.
/meeting-notes/

# Build output left on disk from the desktop app and the phone relay, which
# this branch does not carry (their own .gitignore files went with them).
/desktop/
/relay/
